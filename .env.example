  # =============================================================================
  # go-core Configuration
  # Copy this file to .env and fill in your values.
  # See docs/guides/ENV_VARIABLES.md for full documentation.
  # =============================================================================

  # -----------------------------------------------------------------------------
  # Database (PostgreSQL)
  # -----------------------------------------------------------------------------
  DB_HOST=localhost
  DB_PORT=5432
  DB_USER=postgres
  DB_PASSWORD=your_password
  DB_NAME=auth_db
  DB_SSL_MODE=disable

  # -----------------------------------------------------------------------------
  # Redis
  # -----------------------------------------------------------------------------
  REDIS_HOST=localhost
  REDIS_PORT=6379
  REDIS_PASSWORD=
  REDIS_DB=0

  # -----------------------------------------------------------------------------
  # JWT (REQUIRED — use strong random values in production)
  # -----------------------------------------------------------------------------
  JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
  REFRESH_TOKEN_SECRET=change-me-to-a-different-random-string

  # Token lifetimes
  ACCESS_TOKEN_EXPIRATION_MINUTES=15
  REFRESH_TOKEN_EXPIRATION_HOURS=720

  # -----------------------------------------------------------------------------
  # Application
  # -----------------------------------------------------------------------------
  PORT=8080
  APP_ENV=development
  FRONTEND_URL=http://localhost:3000

  # -----------------------------------------------------------------------------
  # Email (SMTP)
  # -----------------------------------------------------------------------------
  SMTP_HOST=smtp.gmail.com
  SMTP_PORT=587
  SMTP_USERNAME=
  SMTP_PASSWORD=
  SMTP_FROM=noreply@yourapp.com

  # -----------------------------------------------------------------------------
  # OAuth2 Providers (optional — configure per-app via Admin GUI)
  # -----------------------------------------------------------------------------

  # Google
  GOOGLE_CLIENT_ID=
  GOOGLE_CLIENT_SECRET=
  GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

  # Facebook
  FACEBOOK_APP_ID=
  FACEBOOK_APP_SECRET=
  FACEBOOK_REDIRECT_URL=http://localhost:8080/auth/facebook/callback

  # GitHub
  GITHUB_CLIENT_ID=
  GITHUB_CLIENT_SECRET=
  GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

  # -----------------------------------------------------------------------------
  # OIDC Provider (optional)
  # -----------------------------------------------------------------------------
  PUBLIC_URL=https://auth.example.com
  # OIDC_ID_TOKEN_EXPIRATION_MINUTES=60
  # OIDC_AUTH_CODE_EXPIRATION_MINUTES=5

  # -----------------------------------------------------------------------------
  # SMS / Twilio (optional — set SMS_PROVIDER=twilio to enable)
  # -----------------------------------------------------------------------------
  # SMS_PROVIDER=twilio
  # SMS_TWILIO_ACCOUNT_SID=
  # SMS_TWILIO_AUTH_TOKEN=
  # SMS_TWILIO_FROM_NUMBER=

  # -----------------------------------------------------------------------------
  # GeoIP (optional — CIDR rules still work without this)
  # -----------------------------------------------------------------------------
  # GEOIP_DB_PATH=/data/GeoLite2-City.mmdb

  # -----------------------------------------------------------------------------
  # Activity Logging (optional — sensible defaults apply)
  # -----------------------------------------------------------------------------
  # LOG_CLEANUP_ENABLED=true
  # LOG_CLEANUP_INTERVAL=24h
  # LOG_ANOMALY_DETECTION_ENABLED=true
  # LOG_RETENTION_CRITICAL=365
  # LOG_RETENTION_IMPORTANT=180
  # LOG_RETENTION_INFORMATIONAL=90
  ENVEOF
