# =============================================================================
# go-core reference app (.env)
# Used by cmd/api only. The module itself never reads these.
# See docs/guides/ENV_VARIABLES.md
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_core
DB_SSLMODE=disable

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=1

# -----------------------------------------------------------------------------
# JWT (required — 32+ characters)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
ACCESS_TOKEN_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_HOURS=720

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PORT=8080
GIN_MODE=debug
MULTI_TENANT=false
PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
APP_NAME=

# -----------------------------------------------------------------------------
# Admin GUI
# -----------------------------------------------------------------------------
ADMIN_API_KEY=
ADMIN_EMAIL=
ADMIN_SESSION_EXPIRATION_HOURS=8
ADMIN_BASE_URL=
ADMIN_BASE_PATH=/gui
# ADMIN_BRANDING_ORG_NAME=
# ADMIN_BRANDING_LOGO_URL=
# ADMIN_BRANDING_PRIMARY_COLOR=
# ADMIN_BRANDING_SECONDARY_COLOR=
# ADMIN_BRANDING_BORDER_RADIUS=
# ADMIN_BRANDING_SIDEBAR_COLOR=
# ADMIN_BRANDING_SIDEBAR_TEXT_COLOR=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# -----------------------------------------------------------------------------
# OIDC (optional)
# -----------------------------------------------------------------------------
OIDC_ENABLED=false
# OIDC_ID_TOKEN_EXPIRATION_MINUTES=60
# OIDC_AUTH_CODE_EXPIRATION_MINUTES=10

# -----------------------------------------------------------------------------
# WebAuthn (optional)
# -----------------------------------------------------------------------------
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Auth API
# WEBAUTHN_RP_ORIGINS=http://localhost:8080

# -----------------------------------------------------------------------------
# SMS / Twilio (optional)
# -----------------------------------------------------------------------------
# SMS_PROVIDER=twilio
# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=
# SMS_TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# OAuth redirect allowlist (provider secrets are per-app in the admin GUI)
# -----------------------------------------------------------------------------
# ALLOWED_REDIRECT_DOMAINS=localhost:5173,localhost:3000
# DEFAULT_REDIRECT_URI=http://localhost:5173/auth/callback

# -----------------------------------------------------------------------------
# GeoIP (optional — CIDR rules still work without this)
# -----------------------------------------------------------------------------
# GEOIP_DB_PATH=/data/GeoLite2-City.mmdb

# -----------------------------------------------------------------------------
# Session groups
# -----------------------------------------------------------------------------
# SESSION_GROUP_EXPIRY_REVOCATION_ENABLED=false
# SESSION_GROUP_EXPIRY_SCAN_INTERVAL=5m
# SESSION_GROUP_KEYSPACE_NOTIF_ENABLED=false
# REDIS_NOTIFY_KEYSPACE_EVENTS=Ex

# -----------------------------------------------------------------------------
# Activity logging (optional — defaults in internal/config/logging.go)
# -----------------------------------------------------------------------------
# LOG_CLEANUP_ENABLED=true
# LOG_CLEANUP_INTERVAL=24h
# LOG_ANOMALY_DETECTION_ENABLED=true
# LOG_RETENTION_CRITICAL=365
# LOG_RETENTION_IMPORTANT=180
# LOG_RETENTION_INFORMATIONAL=90
