{{define "operator_roles"}}
{{if .CanWrite}}
<div class="mb-3">
    <button class="btn btn-primary btn-sm"
            hx-get="{{basePath}}/operator/roles/new"
            hx-target="#operator-form-container"
            hx-swap="innerHTML">
        <i class="bi bi-plus-lg me-1"></i>Create role
    </button>
</div>
{{end}}
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        {{if .CustomRoles}}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Name</th>
                        <th>Kind</th>
                        <th>Grants</th>
                        <th class="pe-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .CustomRoles}}
                    <tr>
                        <td class="ps-3">{{.Name}}</td>
                        <td>
                            {{if .IsSystem}}
                            <span class="badge bg-secondary bg-opacity-10 text-secondary">system</span>
                            {{else}}
                            <span class="badge bg-primary bg-opacity-10 text-primary">custom</span>
                            {{end}}
                        </td>
                        <td>
                            {{if .Grants}}
                            <small class="text-muted">{{len .Grants}}</small>
                            {{else}}
                            <small class="text-muted">0</small>
                            {{end}}
                        </td>
                        <td class="pe-3 text-end">
                            {{if and $.CanWrite (not .IsSystem)}}
                            <button class="btn btn-outline-primary btn-sm me-1"
                                    hx-get="{{basePath}}/operator/roles/{{.ID}}/edit"
                                    hx-target="#operator-form-container"
                                    hx-swap="innerHTML">
                                Edit
                            </button>
                            <button class="btn btn-outline-danger btn-sm"
                                    hx-delete="{{basePath}}/operator/roles/{{.ID}}"
                                    hx-target="#operator-flash"
                                    hx-swap="innerHTML"
                                    hx-confirm="Delete role {{.Name}}?">
                                Delete
                            </button>
                            {{end}}
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="text-center py-5 text-muted">
            <i class="bi bi-person-badge fs-1"></i>
            <p class="mt-2 mb-0">No operator roles found.</p>
        </div>
        {{end}}
    </div>
</div>
{{end}}
