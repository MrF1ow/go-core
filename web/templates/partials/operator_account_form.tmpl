{{define "operator_account_form"}}
<div class="card border-0 shadow-sm border-start border-primary border-3">
    <div class="card-body">
        <h6 class="fw-bold mb-3">
            <i class="bi bi-plus-lg me-2"></i>Create operator
        </h6>
        <form hx-post="{{basePath}}/operator/accounts"
              hx-target="#operator-form-container"
              hx-swap="innerHTML">
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="operatorUsername" class="form-label small text-muted">Username</label>
                    <input type="text" class="form-control" id="operatorUsername" name="username"
                           minlength="3" maxlength="50" required autofocus>
                </div>
                <div class="col-md-4">
                    <label for="operatorEmail" class="form-label small text-muted">Email <span class="text-muted">(optional)</span></label>
                    <input type="email" class="form-control" id="operatorEmail" name="email">
                </div>
                <div class="col-md-4">
                    <label for="operatorPassword" class="form-label small text-muted">Password</label>
                    <input type="password" class="form-control" id="operatorPassword" name="password"
                           minlength="12" maxlength="128" required>
                </div>
                <div class="col-md-4">
                    <label for="operatorAppId" class="form-label small text-muted">Application</label>
                    <select class="form-select" id="operatorAppId" name="app_id">
                        <option value="">Platform</option>
                        {{range .Apps}}
                        <option value="{{.ID}}">{{.Name}} ({{.TenantName}})</option>
                        {{end}}
                    </select>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Create
                </button>
            </div>
        </form>
    </div>
</div>
{{end}}
