{{define "base"}}
<!DOCTYPE html>
<html lang="en" data-bs-theme="{{if .Theme}}{{.Theme}}{{else}}light{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{.CSRFToken}}">
    <title>{{block "title" .}}Admin{{end}} - {{if .OrgName}}{{.OrgName}}{{else}}Auth API{{end}}</title>
    <!-- Apply theme from cookie before CSS loads to prevent flash of wrong theme.
         This is the single source of truth for all pages regardless of whether
         the Go handler populates TemplateData.Theme. -->
    <script>
        (function () {
            try {
                var cookies = document.cookie.split(';');
                for (var i = 0; i < cookies.length; i++) {
                    var c = cookies[i].trim();
                    if (c.startsWith('gui_theme=')) {
                        var t = c.substring('gui_theme='.length);
                        if (t === 'dark') {
                            document.documentElement.setAttribute('data-bs-theme', 'dark');
                        }
                        break;
                    }
                }
            } catch (e) {}
        })();
    </script>
    {{template "favicon" .}}
    <link rel="stylesheet" href="{{basePath}}/static/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{basePath}}/static/css/bootstrap-icons.min.css">
    {{block "head" .}}{{end}}
    <style>
        :root {
            --sidebar-width: 260px;
        }
        body {
            min-height: 100vh;
        }
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            box-shadow: 2px 0 12px rgba(0, 0, 0, 0.15);
        }
        .sidebar-nav-scroll {
            flex: 1;
            overflow-y: auto;
            min-height: 0;
        }
        .sidebar-footer {
            flex-shrink: 0;
        }
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
        }
        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.75);
            border-radius: 0.375rem;
            margin: 0.125rem 0.75rem;
            padding: 0.5rem 1rem;
        }
        .sidebar .nav-link:hover {
            color: #fff;
            background-color: rgba(255, 255, 255, 0.1);
        }
        .sidebar .nav-link.active {
            color: #fff;
            background-color: rgba(255, 255, 255, 0.2);
        }
        .sidebar .nav-link i {
            width: 1.5rem;
            text-align: center;
            margin-right: 0.5rem;
        }
        .sidebar-heading {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: rgba(255, 255, 255, 0.4);
            padding: 1rem 1.75rem 0.5rem;
        }
        @media (max-width: 768px) {
            .sidebar {
                margin-left: calc(-1 * var(--sidebar-width));
                transition: margin-left 0.3s ease;
            }
            .sidebar.show {
                margin-left: 0;
            }
            .main-content {
                margin-left: 0;
            }
        }
        /* Dark mode: deepen the sidebar so it reads as a distinct surface */
        [data-bs-theme="dark"] .sidebar {
            background-color: #101214 !important;
            border-right: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 2px 0 12px rgba(0, 0, 0, 0.5);
        }
        /* Dark mode: override Bootstrap's hardcoded light colours on .table-secondary
           so inactive rows (e.g. IP Rules) don't appear as bright patches in a dark table */
        [data-bs-theme="dark"] .table-secondary {
            --bs-table-color: rgba(255, 255, 255, 0.45);
            --bs-table-bg: rgba(255, 255, 255, 0.05);
            --bs-table-border-color: rgba(255, 255, 255, 0.08);
            --bs-table-striped-bg: rgba(255, 255, 255, 0.06);
            --bs-table-striped-color: rgba(255, 255, 255, 0.45);
            --bs-table-active-bg: rgba(255, 255, 255, 0.09);
            --bs-table-active-color: rgba(255, 255, 255, 0.45);
            --bs-table-hover-bg: rgba(255, 255, 255, 0.08);
            --bs-table-hover-color: rgba(255, 255, 255, 0.45);
        }
    </style>
    {{if or .PrimaryColor .SecondaryColor .BorderRadius .SidebarColor}}
    <style>
        {{if or .PrimaryColor .SecondaryColor .BorderRadius}}
        :root {
            {{if .PrimaryColor}}--bs-primary: {{.PrimaryColor}};{{end}}
            {{if .SecondaryColor}}--bs-secondary: {{.SecondaryColor}};{{end}}
            {{if .BorderRadius}}--bs-border-radius: {{.BorderRadius}};{{end}}
        }
        {{end}}
        {{if .PrimaryColor}}
        .btn-primary {
            --bs-btn-bg: {{.PrimaryColor}};
            --bs-btn-border-color: {{.PrimaryColor}};
            --bs-btn-hover-bg: color-mix(in srgb, {{.PrimaryColor}} 85%, black);
            --bs-btn-hover-border-color: color-mix(in srgb, {{.PrimaryColor}} 75%, black);
            --bs-btn-active-bg: color-mix(in srgb, {{.PrimaryColor}} 75%, black);
            --bs-btn-active-border-color: color-mix(in srgb, {{.PrimaryColor}} 75%, black);
        }
        .text-primary { color: {{.PrimaryColor}} !important; }
        {{end}}
        {{if .SidebarColor}}
        .sidebar { background-color: {{.SidebarColor}} !important; }
        .sidebar .nav-link { color: {{.SidebarTextColor}}; opacity: 0.75; }
        .sidebar .nav-link:hover { color: {{.SidebarTextColor}}; opacity: 1; }
        .sidebar .nav-link.active { color: {{.SidebarTextColor}}; opacity: 1; }
        .sidebar-heading { color: {{.SidebarTextColor}}; opacity: 0.5; }
        [data-bs-theme="dark"] .sidebar { background-color: {{.SidebarColor}} !important; }
        {{end}}
    </style>
    {{end}}
    {{if .CustomCSS}}
    <style>
{{.CustomCSS}}
    </style>
    {{end}}
</head>
<body>
    <!-- Sidebar -->
    <nav class="sidebar bg-dark d-flex flex-column" id="sidebar-nav">
        <div class="p-3">
            <a href="{{basePath}}/" class="text-white text-decoration-none d-flex align-items-center sidebar-link"
               data-page="dashboard"
               hx-get="{{basePath}}/" hx-target="#page-content" hx-select="#page-content" hx-swap="outerHTML show:no-scroll" hx-push-url="true">
                {{if .LogoURL}}<img src="{{.LogoURL}}" alt="{{if .OrgName}}{{.OrgName}}{{else}}Auth API{{end}}" style="height:28px;width:28px;object-fit:contain;" class="me-2">{{else}}<i class="bi bi-shield-lock fs-4 me-2"></i>{{end}}
                <span class="fs-5 fw-semibold">{{if .OrgName}}{{.OrgName}}{{else}}Auth API{{end}}</span>
            </a>
        </div>
        <hr class="text-secondary mx-3 my-0">

        <!-- Scrollable navigation area -->
        <div class="sidebar-nav-scroll">
            {{range .NavGroups}}
            {{if .Heading}}<div class="sidebar-heading">{{.Heading}}</div>{{end}}
            <ul class="nav flex-column{{if not .Heading}} mt-2{{end}}">
                {{range .Items}}
                <li class="nav-item">
                    <a class="nav-link sidebar-link{{if eq $.ActivePage .Page}} active{{end}}" href="{{.Path}}"
                       data-page="{{.Page}}"
                       hx-get="{{.Path}}" hx-target="#page-content" hx-select="#page-content" hx-swap="outerHTML show:no-scroll" hx-push-url="true">
                        <i class="bi {{.Icon}}"></i> {{.Label}}
                    </a>
                </li>
                {{end}}
            </ul>
            {{end}}
        </div>

        <!-- Sticky footer: always visible at bottom -->
        <div class="sidebar-footer">
            <hr class="text-secondary mx-3 my-0">
            <ul class="nav flex-column my-1">
                <li class="nav-item">
                    <a class="nav-link sidebar-link{{if eq .ActivePage "my-account"}} active{{end}}" href="{{basePath}}/my-account"
                       data-page="my-account"
                       hx-get="{{basePath}}/my-account" hx-target="#page-content" hx-select="#page-content" hx-swap="outerHTML show:no-scroll" hx-push-url="true">
                        <i class="bi bi-person-gear"></i> My Account
                    </a>
                </li>
            </ul>
            <hr class="text-secondary mx-3 my-0">
            <!-- Theme toggle -->
            <div class="px-3 pt-2 pb-1">
                <button id="theme-toggle" class="btn btn-sm w-100 text-start border-0 text-white-50 px-1 py-1"
                        onclick="toggleTheme()" style="background:transparent;" title="Toggle light/dark theme">
                    <i class="bi bi-sun-fill me-2" id="theme-icon-light"></i>
                    <i class="bi bi-moon-stars-fill me-2" id="theme-icon-dark"></i>
                    <span id="theme-label"></span>
                </button>
            </div>
            <div class="p-3 pt-1">
                <div class="d-flex align-items-center text-white-50">
                    <i class="bi bi-person-circle me-2"></i>
                    <small>{{.AdminUsername}}</small>
                    <a href="{{basePath}}/logout" class="ms-auto text-white-50" title="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main content -->
    <div class="main-content" id="main-content">
        <!-- Top navbar (mobile toggle + breadcrumb) -->
        <nav class="navbar bg-body-tertiary border-bottom px-3 d-md-none">
            <button class="btn btn-outline-secondary btn-sm" onclick="document.querySelector('.sidebar').classList.toggle('show')">
                <i class="bi bi-list"></i>
            </button>
            <span class="navbar-text fw-semibold">{{if .OrgName}}{{.OrgName}}{{else}}Auth API{{end}} Admin</span>
        </nav>

        <!-- Page content wrapper (HTMX swaps this on sidebar navigation) -->
        <div id="page-content" data-active-page="{{.ActivePage}}">


            <!-- Flash messages -->
            <div class="container-fluid p-4">
                {{if .FlashSuccess}}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>{{.FlashSuccess}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                {{end}}
                {{if .FlashError}}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>{{.FlashError}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                {{end}}

                {{block "content" .}}{{end}}
            </div>

            <!-- Page-specific scripts -->
            {{block "scripts" .}}{{end}}
        </div>
    </div>

    <script src="{{basePath}}/static/js/bootstrap.bundle.min.js"></script>
    <script src="{{basePath}}/static/js/htmx.min.js"></script>
    <script>
        // Set CSRF token for all HTMX requests
        document.body.addEventListener('htmx:configRequest', function(event) {
            var csrfMeta = document.querySelector('meta[name="csrf-token"]');
            if (csrfMeta) {
                event.detail.headers['X-CSRF-Token'] = csrfMeta.content;
            }
        });

        document.body.addEventListener('htmx:beforeSwap', function(event) {
            var xhr = event.detail.xhr;
            if (!xhr) return;
            if (xhr.getResponseHeader('X-GUI-Forbidden') === '1') {
                event.detail.shouldSwap = true;
                event.detail.isError = false;
            }
        });

        // Track current active page to detect navigation changes
        var currentActivePage = (document.getElementById('page-content') || {}).getAttribute('data-active-page') || '';

        function updateSidebarActiveState() {
            var pageContent = document.getElementById('page-content');
            if (!pageContent) return;

            var activePage = pageContent.getAttribute('data-active-page') || '';

            // Update sidebar active link
            document.querySelectorAll('#sidebar-nav .sidebar-link').forEach(function(link) {
                if (link.getAttribute('data-page') === activePage) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });

            // Update page title
            var titleMap = {
                'dashboard': 'Dashboard',
                'tenants': 'Tenants',
                'applications': 'Applications',
                'users': 'Users',
                'oauth': 'OAuth Config',
                'sessions': 'Sessions',
                'ip-rules': 'IP Rules',
                'roles': 'Roles',
                'permissions': 'Permissions',
                'user-roles': 'User Roles',
                'email-servers': 'Email Servers',
                'email-templates': 'Email Templates',
                'email-types': 'Email Types',
                'logs': 'Activity Logs',
                'api-keys': 'API Keys',
                'webhooks': 'Webhooks',
                'session-groups': 'Session Groups',
                'monitoring': 'System Health',
                'settings': 'Settings',
                'my-account': 'My Account'
            };
            if (activePage && titleMap[activePage]) {
                document.title = titleMap[activePage] + ' - {{if .OrgName}}{{.OrgName}}{{else}}Auth API{{end}}';
            }

            currentActivePage = activePage;
        }

        // After HTMX settles, check if the active page changed (sidebar navigation)
        document.body.addEventListener('htmx:afterSettle', function(event) {
            var pageContent = document.getElementById('page-content');
            if (!pageContent) return;

            var newActivePage = pageContent.getAttribute('data-active-page') || '';
            if (newActivePage !== currentActivePage) {
                updateSidebarActiveState();
                window.scrollTo(0, 0);
            }
        });

        // Handle browser back/forward buttons
        var htmxNavigation = false;
        document.body.addEventListener('htmx:pushedIntoHistory', function() {
            htmxNavigation = true;
        });
        window.addEventListener('popstate', function(e) {
            if (htmxNavigation && typeof htmx !== 'undefined') {
                htmx.ajax('GET', window.location.pathname + window.location.search, {
                    target: '#page-content',
                    select: '#page-content',
                    swap: 'outerHTML show:no-scroll'
                }).then(function() {
                    updateSidebarActiveState();
                });
            }
        });

        // ---- Theme toggle ----
        function toggleTheme() {
            var html = document.documentElement;
            var current = html.getAttribute('data-bs-theme');
            var next = current === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-bs-theme', next);
            // Persist in a 1-year cookie (not HttpOnly — must be readable by JS)
            var secure = location.protocol === 'https:' ? '; Secure' : '';
            document.cookie = 'gui_theme=' + next + '; path=/gui; max-age=31536000; SameSite=Strict' + secure;
            updateThemeToggleUI(next);
        }

        function updateThemeToggleUI(theme) {
            var iconLight = document.getElementById('theme-icon-light');
            var iconDark  = document.getElementById('theme-icon-dark');
            var label     = document.getElementById('theme-label');
            if (!iconLight || !iconDark || !label) return;
            if (theme === 'dark') {
                iconLight.style.display = 'none';
                iconDark.style.display  = 'inline';
                label.textContent = 'Dark mode';
            } else {
                iconLight.style.display = 'inline';
                iconDark.style.display  = 'none';
                label.textContent = 'Light mode';
            }
        }

        // Initialize theme toggle UI on first load
        updateThemeToggleUI(document.documentElement.getAttribute('data-bs-theme') || 'light');
    </script>
</body>
</html>
{{end}}
