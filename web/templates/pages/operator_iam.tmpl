{{define "operator_iam"}}
{{template "base" .}}
{{end}}

{{define "title"}}Operator IAM{{end}}

{{define "content"}}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0 fw-bold">
        <i class="bi bi-shield-shaded me-2"></i>Operator IAM
    </h4>
    {{if eq .Data.Tab "events"}}
    <a href="{{basePath}}/operator/iam-events/export"
       class="btn btn-sm btn-outline-success">
        <i class="bi bi-filetype-csv me-1"></i>Export CSV
    </a>
    {{else if eq .Data.Tab "access-logs"}}
    <a href="{{basePath}}/operator/access-logs/export"
       class="btn btn-sm btn-outline-success">
        <i class="bi bi-filetype-csv me-1"></i>Export CSV
    </a>
    {{else}}
    <a href="{{basePath}}/operator/roster/export"
       class="btn btn-sm btn-outline-success">
        <i class="bi bi-filetype-csv me-1"></i>Export CSV
    </a>
    {{end}}
</div>

<div class="alert alert-info alert-dismissible fade show py-2 small mb-3" role="alert">
    <i class="bi bi-info-circle me-1"></i>
    Exports are capped at <strong>10,000 rows</strong>.{{if eq .Data.Tab "roster"}} The env_key break-glass principal is always listed first.{{end}}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="padding-top: 0.5rem;"></button>
</div>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link{{if eq .Data.Tab "roster"}} active{{end}}"
           href="{{basePath}}/operator"
           hx-get="{{basePath}}/operator"
           hx-target="#page-content"
           hx-select="#page-content"
           hx-swap="outerHTML show:no-scroll"
           hx-push-url="true">Roster</a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link{{if eq .Data.Tab "events"}} active{{end}}"
           href="{{basePath}}/operator/iam-events"
           hx-get="{{basePath}}/operator/iam-events"
           hx-target="#page-content"
           hx-select="#page-content"
           hx-swap="outerHTML show:no-scroll"
           hx-push-url="true">Events</a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link{{if eq .Data.Tab "access-logs"}} active{{end}}"
           href="{{basePath}}/operator/access-logs"
           hx-get="{{basePath}}/operator/access-logs"
           hx-target="#page-content"
           hx-select="#page-content"
           hx-swap="outerHTML show:no-scroll"
           hx-push-url="true">Access logs</a>
    </li>
</ul>

{{if eq .Data.Tab "events"}}
<div id="operator-iam-events">
    {{template "operator_iam_events" .Data}}
</div>
{{else if eq .Data.Tab "access-logs"}}
<div id="operator-access-logs">
    {{template "operator_access_logs" .Data}}
</div>
{{else}}
<div id="operator-roster"
     hx-get="{{basePath}}/operator/roster"
     hx-trigger="load"
     hx-swap="innerHTML">
    {{template "operator_roster" .Data}}
</div>
{{end}}
{{end}}
